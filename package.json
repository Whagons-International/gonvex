{
  "name": "gonvex-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @gonvex/protocol build && pnpm --filter @gonvex/client build && pnpm --filter @gonvex/expo-sqlite build && pnpm --filter @gonvex/react build && pnpm --filter @gonvex/module-sdk build && pnpm --filter @gonvex/cli build && pnpm --filter create-gonvex build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:production-compose": "node --test scripts/production-compose.test.mjs",
    "test:coolify-deploy": "node --test scripts/deploy-coolify.test.mjs",
    "test:release": "node --test scripts/release-cli.test.mjs",
    "verify:package-tarballs": "node scripts/verify-package-tarballs.mjs",
    "release:cli": "node scripts/release-cli.mjs",
    "release:cli:dry-run": "node scripts/release-cli.mjs --dry-run",
    "release:notes": "node scripts/release-cli.mjs --notes-preview",
    "dev:docs": "pnpm --filter @gonvex/docs dev",
    "dev:packages": "pnpm --parallel --filter @gonvex/protocol --filter @gonvex/client --filter @gonvex/expo-sqlite --filter @gonvex/react --filter @gonvex/module-sdk --filter @gonvex/cli --filter create-gonvex dev",
    "dev:dashboard": "pnpm --filter @gonvex/dashboard dev",
    "dev:cli": "pnpm --filter @gonvex/cli exec gonvex dev --project apps/dashboard",
    "dev:runtime": "cargo build --locked --manifest-path rust/Cargo.toml -p gonvex-module-host -p gonvex-sandbox-worker && GONVEX_MODULE_HOST_BINARY=\"$PWD/rust/target/debug/gonvex-module-host\" GONVEX_SANDBOX_WORKER_BINARY=\"$PWD/rust/target/debug/gonvex-sandbox-worker\" cargo run --locked --manifest-path rust/Cargo.toml -p gonvex-runtime",
    "admin": "cargo run --locked --manifest-path rust/Cargo.toml -p gonvex-admin --"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "protobufjs"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.45",
    "@playwright/test": "^1.61.0",
    "ai": "7.0.71",
    "ws": "^8.21.0"
  }
}
