# syntax=docker/dockerfile:1
FROM rust:1.94-bookworm AS build
WORKDIR /src
COPY rust rust
COPY packages/module-sdk/runtime-contract packages/module-sdk/runtime-contract
RUN --mount=type=cache,id=gvmac-cargo-registry,target=/usr/local/cargo/registry --mount=type=cache,id=gvmac-cargo-target,target=/src/rust/target CARGO_BUILD_JOBS=4 cargo build --locked --manifest-path rust/Cargo.toml --profile local-load --config 'profile.local-load.inherits="release"' --config 'profile.local-load.debug-assertions=true' --features gonvex-runtime/test-firebase-auth-emulator -p gonvex-runtime -p gonvex-module-host -p gonvex-sandbox-worker && mkdir /out && cp rust/target/local-load/gonvex-runtime rust/target/local-load/gonvex-module-host rust/target/local-load/gonvex-sandbox-worker /out/
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /usr/local/bin/
CMD ["gonvex-runtime"]
