# The Rust runtime owns HTTP, authentication, tenant routing, Postgres
# transactions, the change feed, visibility, and the replica protocol. The
# separately bounded V8 process owns TypeScript application execution only.
FROM rust:1.94-bookworm AS rust-build
WORKDIR /src/rust
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates ./crates
RUN cargo build --locked --release \
    -p gonvex-admin \
    -p gonvex-runtime \
    -p gonvex-module-host \
    -p gonvex-sandbox-worker

FROM debian:bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/gonvex/data /var/lib/gonvex/tmp
COPY --from=rust-build /src/rust/target/release/gonvex-runtime /usr/local/bin/gonvex-runtime
COPY --from=rust-build /src/rust/target/release/gonvex-admin /usr/local/bin/gonvex-admin
COPY --from=rust-build /src/rust/target/release/gonvex-module-host /usr/local/bin/gonvex-module-host
COPY --from=rust-build /src/rust/target/release/gonvex-sandbox-worker /usr/local/bin/gonvex-sandbox-worker
# Data-file artifacts (DuckDB databases for assistant-uploaded CSV/XLSX/XLS)
# live here; mount a volume to keep them across deploys. Artifacts re-ingest
# from object storage on miss, so an ephemeral dir also works (just slower on
# first access after a redeploy).
ENV GONVEX_ADDR=0.0.0.0:8080 \
    GONVEX_MODULE_HOST_ENABLED=true \
    GONVEX_MODULE_HOST_BINARY=/usr/local/bin/gonvex-module-host \
    GONVEX_SANDBOX_WORKER_BINARY=/usr/local/bin/gonvex-sandbox-worker \
    GONVEX_DATA_DIR=/var/lib/gonvex/data \
    GONVEX_TELEMETRY_LOG=/var/lib/gonvex/telemetry.jsonl \
    TMPDIR=/var/lib/gonvex/tmp
WORKDIR /var/lib/gonvex
USER 0:0
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=30 \
  CMD curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8080/healthz >/dev/null
CMD ["gonvex-runtime"]
