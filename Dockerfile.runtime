# The runtime compiles each project's synced Go functions into a -buildmode=plugin
# .so at sync time and dlopen()s it, so the *running* image needs a full Go
# toolchain + cgo (gcc) and the gonvex module source — not just the static binary.
# Debian (glibc) is used rather than Alpine/musl because Go plugins are unreliable
# under musl. The runtime binary and the plugins must be built with the same Go
# version and the same gonvex source (via the go.mod replace) for plugin ABI match.
FROM golang:1.26.10@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551 AS build
WORKDIR /src
# Go plugin package hashes include the absolute module-cache source path. Build
# the host runtime from the same paths used later by the in-image plugin
# compiler, otherwise identical dependencies fail plugin.Open after deploy.
# Compiler-owned state deliberately stays outside /var/lib/gonvex because
# production mounts its persistent runtime volume over that entire directory.
ENV GOCACHE=/var/cache/gonvex/go-build \
    GOMODCACHE=/opt/gonvex/go/pkg/mod \
    GOPATH=/opt/gonvex/go \
    GOMAXPROCS=2 \
    GOFLAGS="-mod=mod -p=2"
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# cgo-enabled: -buildmode=plugin requires the host binary to be cgo/dynamically linked.
RUN CGO_ENABLED=1 go build -o /out/gonvex-runtime ./server/cmd/gonvex-runtime

FROM golang:1.26.10@sha256:cfa27959837144bf4649802ba38e59daffd0dd2a7994aa83daaf113285b0f551
WORKDIR /app
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /var/cache/gonvex/go-build /var/cache/gonvex/tmp /var/lib/gonvex/data /var/lib/gonvex/plugins
# Gonvex module source: synced project bundles render
#   replace github.com/gonvex/gonvex => $GONVEX_MODULE_ROOT
# so the plugin build resolves the framework against this checkout.
COPY --from=build /src /src
# Preserve the exact module-cache path used to compile the host binary so
# plugin package hashes remain ABI-compatible at runtime.
COPY --from=build /opt/gonvex/go/pkg/mod /opt/gonvex/go/pkg/mod
COPY --from=build /out/gonvex-runtime /usr/local/bin/gonvex-runtime
# Data-file artifacts (DuckDB databases for assistant-uploaded CSV/XLSX/XLS)
# live here; mount a volume to keep them across deploys. Artifacts re-ingest
# from object storage on miss, so an ephemeral dir also works (just slower on
# first access after a redeploy).
ENV GONVEX_ADDR=0.0.0.0:8080 \
    GONVEX_RELOAD_SUPERVISOR=true \
    GONVEX_MODULE_ROOT=/src \
    GONVEX_PLUGIN_CACHE_DIR=/var/lib/gonvex/plugins \
    GONVEX_DATA_DIR=/var/lib/gonvex/data \
    GONVEX_TELEMETRY_LOG=/var/lib/gonvex/telemetry.jsonl \
    GOCACHE=/var/cache/gonvex/go-build \
    GOMODCACHE=/opt/gonvex/go/pkg/mod \
    GOPATH=/opt/gonvex/go \
    TMPDIR=/var/cache/gonvex/tmp \
    CGO_ENABLED=1 \
    GOMAXPROCS=2 \
    GOFLAGS="-mod=mod -p=2"
WORKDIR /var/lib/gonvex
USER 0:0
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=30 \
  CMD bash -ec 'exec 3<>/dev/tcp/127.0.0.1/8080; printf "GET /healthz HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n" >&3; grep -q "200 OK" <&3'
CMD ["gonvex-runtime"]
