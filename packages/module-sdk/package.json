{
  "name": "@gonvex/module-sdk",
  "version": "0.5.2-staging.30",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./runtime-contract": {
      "types": "./dist/runtime-globals.d.ts",
      "default": "./dist/runtime-globals.js"
    },
    "./runtime-contract/vectors.json": "./runtime-contract/vectors.json",
    "./runtime-contract/runner.js": "./runtime-contract/runner.js",
    "./runtime-contract/globals.js": {
      "types": "./runtime-contract/globals.d.ts",
      "default": "./runtime-contract/globals.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "runtime-contract",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
