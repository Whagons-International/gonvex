{
  "name": "@gonvex/local-runtime",
  "version": "0.5.2-staging.13",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker-client": {
      "types": "./dist/worker-client.d.ts",
      "default": "./dist/worker-client.js"
    },
    "./native-bridge": {
      "types": "./dist/native-bridge.d.ts",
      "default": "./dist/native-bridge.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@gonvex/module-sdk": "workspace:*",
    "@ungap/structured-clone": "1.4.0"
  },
  "devDependencies": {
    "@types/ungap__structured-clone": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
