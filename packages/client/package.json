{
  "name": "@gonvex/client",
  "version": "0.5.2-staging.29",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "bench:sync-engine": "pnpm build && node bench/sync-engine/run.mjs",
    "bench:sync-engine:chromium": "pnpm build && node bench/sync-engine/chromium.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:sync-engine:check": "node --test bench/sync-engine/statistics.checks.mjs"
  },
  "dependencies": {
    "@gonvex/protocol": "workspace:*",
    "dexie": "^4.4.4",
    "@gonvex/local-runtime": "workspace:*",
    "@gonvex/module-sdk": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.4",
    "typescript": "7.0.2",
    "vitest": "^4.1.6"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ]
}
