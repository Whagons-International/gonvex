{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "kernel", "worker-configuration.d.ts"],
  // K01 tests that run SDK code from its sources (vitest.config.ts alias):
  // ports of the SDK's SQL suites and SDK helpers on the storage layer. The
  // SDK is written for the repo's base flags, not these, and like the
  // originals these files are run by the test runner, not type-checked here.
  // kernel/host (K04) has its own tsconfig, vitest config and test Worker.
  // kernel/files (K13) too, and checks router/storage with it.
  // kernel/principals (K17): its harness imports K06 (Node types); kernel/principals/tsconfig.json checks it.
  // kernel/telemetry/test (K15) is checked by kernel/telemetry/tsconfig.json (it imports the control object).
  "exclude": ["kernel/storage/test/sdk", "kernel/host", "kernel/files", "kernel/principals/harness", "kernel/principals/test", "kernel/telemetry/test"]
}
