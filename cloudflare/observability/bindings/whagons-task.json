  "constraints": {
    "create": [
      "Nonblank name/workspaceId; entityId is optional in schema but required fresh by this proposed synthetic contract.",
      "No materials, attachments, assignees, tags, reminders, provenance overrides, category/template defaults or extra optional fields in this preparation.",
      "A real workspace/category/template may impose additional requirements; defaults and authorization must be audited before execution."
    ],
    "update": [
      "Use tasks.rename rather than legacy tasks.update arbitrary updates.",
      "Match exact _id, workspaceId and synthetic name locally; never export row contents."
    ],
    "remove": [
      "tasks.remove calls archiveTask: deletedAt/deletedBy soft archive, not physical deletion.",
      "Use _id explicitly: taskId/id numeric-looking strings can select human numeric id.",
      "Archive completion cannot prove fixture, taskLogs, scheduler or derived-row retention cleanup."
    ],
    "read": [
      "tasks.get returns an array, bounded to exact _id; tasks.getByNumericId targets human numeric id.",
      "Replica metadata is retained. query() serializes path/args; app tests exercise it but no assembled execution was performed here.",
      "No returned app row establishes a durable commit cursor or actual tenant SQLite deployment.",
      "Existing sdkApplication deliberately refuses this replica ref before connection; do not strip delivery metadata to bypass it."
    ],
    "collection": [
      "watchReplica(tasks.get,{id}) is the proposed exact-row second-client observation.",
      "Require separate authorized identity, authenticated fresh client, complete/up-to-date server state, same epoch and computed revision >= actual commit, exact matching fields.",
      "A query result, collection path, snapshot, cache, sink send or correlation id cannot prove second-client apply."
    ]
  },
