// K04 R25 probe. Deployed only as gonvex-cf-dev-k04-r25 on the development account by run.mjs,
// which writes a copy with `limits.cpu_ms` for each CPU variant and deletes the Worker afterwards.
{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "gonvex-cf-dev-k04-r25",
  "main": "worker.js",
  // Not newer than the pinned workerd (wrangler 4.155.0 -> workerd 1.20261023.1).
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      { "name": "TENANT", "class_name": "TenantDO" },
      { "name": "GATEWAY", "class_name": "GatewayDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO", "GatewayDO"] }],
  "worker_loaders": [{ "binding": "LOADER" }]
}
