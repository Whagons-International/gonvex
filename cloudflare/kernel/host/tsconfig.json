{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test"],
