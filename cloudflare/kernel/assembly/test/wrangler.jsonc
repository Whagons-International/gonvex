{
 "name":"gonvex-cf-dev-k22-composition-test",
 "main":"worker.ts",
 "compatibility_date":"2026-10-23",
 "compatibility_flags":["nodejs_als"],
 "durable_objects":{"bindings":[{"name":"TENANT","class_name":"CompositionTenant"},{"name":"GATEWAY","class_name":"CompositionGateway"},{"name":"CONTROL","class_name":"CompositionGateway"},{"name":"REAL_CONTROL","class_name":"CompositionControl"},{"name":"PUB_CONTROL","class_name":"PublicationControl"},{"name":"PUB_TENANT","class_name":"PublicationTenant"},{"name":"PUB_GATEWAY","class_name":"PublicationGateway"},{"name":"CAPACITY_CONTROLLER","class_name":"CapacityController"},{"name":"CAPACITY_GATEWAY","class_name":"CapacityGateway"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["CompositionTenant","CompositionGateway","CompositionControl","PublicationControl","PublicationTenant","PublicationGateway"]},{"tag":"capacity-test-v1","new_sqlite_classes":["CapacityController","CapacityGateway"]}],
 "r2_buckets":[{"binding":"FILES","bucket_name":"gonvex-cf-dev-k22-composition-files"}],
 "services":[{"binding":"ACTIONS","service":"gonvex-cf-dev-k22-composition-test","entrypoint":"ActionWorker"}],
 "vars":{"GONVEX_ASSEMBLY_FIXTURE_KEY":"capacity-local-only","GONVEX_DEV_TRANSFER_TARGET":"gonvex-cf-dev-test","GONVEX_DEV_TRANSFER_TOKEN":"test-only","GONVEX_DEV_TRANSFER_TENANTS":"devcopy-test,devcopy-refusal,devcopy-large,devcopy-wide"},
 "rules":[{"type":"Text","globs":["**/*.sql"],"fallthrough":true}],
 "workflows":[{"binding":"ACTION_WORKFLOW","name":"gonvex-cf-dev-k22-composition-actions","class_name":"ActionWorkflow"}]
}
