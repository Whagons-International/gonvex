// Test-only Worker for the kernel Reducer path (K07). Never deployed; the name
// keeps the gonvex-cf-dev- prefix anyway.
{
  "name": "gonvex-cf-dev-k07-reducer-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  // AsyncLocalStorage carries the active invocation across awaits (K04 globals.ts).
  "compatibility_flags": ["nodejs_als"],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "GatewayObject" },
      { "name": "CONTROL_STUB", "class_name": "KernelControlStub" },
      { "name": "TENANT_STUB", "class_name": "TestTenant" },
      { "name": "REF", "class_name": "RefTestObject" }
    ]
  },
  "vars": { "GONVEX_RUNTIME_VERSION": "development", "GONVEX_GATEWAY_SHARDS": "2", "GONVEX_PRESENCE": "1" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayObject", "KernelControlStub", "TestTenant", "RefTestObject"] }]
}
