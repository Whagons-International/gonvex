// The K07 conformance Worker (`cloudflare-reducer` backend in
// cloudflare/conformance): the K05 socket path with the K07 tenant object and
// the fixture bundles of the run (generated into .generated/ by
// generate-bundles.mjs before `wrangler dev`). Local only; never deployed.
{
  "name": "gonvex-cf-dev-k07-conformance",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  // AsyncLocalStorage carries the active invocation across awaits (K04 globals.ts).
  "compatibility_flags": ["nodejs_als"],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "GatewayObject" },
      { "name": "CONTROL_STUB", "class_name": "KernelControlStub" },
      { "name": "TENANT_STUB", "class_name": "ConformanceTenant" },
      { "name": "PUBLIC_LIMITER", "class_name": "PublicLimiterObject" }
    ]
  },
  "vars": { "GONVEX_RUNTIME_VERSION": "development", "GONVEX_GATEWAY_SHARDS": "8", "GONVEX_PRESENCE": "1" },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GatewayObject", "KernelControlStub", "ConformanceTenant"] },
    { "tag": "v2", "new_sqlite_classes": ["PublicLimiterObject"] }
  ]
}
