// Test-only Worker for K16's anonymous-call specs (never deployed). The public
// Action timeout is set low so the spec can watch the 60 s rule fire.
{
  "name": "gonvex-cf-dev-k16-calls-test",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_als"],
  "durable_objects": {
    "bindings": [
      { "name": "GATEWAY", "class_name": "GatewayObject" },
      { "name": "CONTROL_STUB", "class_name": "KernelControlStub" },
      { "name": "TENANT_STUB", "class_name": "TestTenant" },
      { "name": "PUBLIC_LIMITER", "class_name": "PublicLimiterObject" }
    ]
  },
  "vars": { "GONVEX_RUNTIME_VERSION": "development", "GONVEX_GATEWAY_SHARDS": "2", "GONVEX_PRESENCE": "1", "GONVEX_PUBLIC_ACTION_TIMEOUT_SECONDS": "60" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayObject", "KernelControlStub", "TestTenant", "PublicLimiterObject"] }]
}
