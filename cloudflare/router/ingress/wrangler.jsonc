// The Ingress Worker (K18). Deploy only under a gonvex-cf-dev- name until
// cutover. `CONTROL` is the control object of the kernel Worker and
// `INGRESS_ACTIONS` the entrypoint that implements `serviceAction` (K12's
// Action Worker or K17's tenant path); their script names are fixed when the
// kernel router is composed. Secrets: GONVEX_INGRESS_SERVICE_TOKEN (its
// SHA-256 goes in the kernel's GONVEX_SERVICE_PRINCIPALS).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gonvex-cf-dev-ingress",
  "main": "worker.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "INGRESS", "class_name": "IngressObject" },
      { "name": "CONTROL", "class_name": "OperatorControlObject", "script_name": "gonvex-cf-dev-kernel" }
    ]
  },
  "services": [{ "binding": "INGRESS_ACTIONS", "service": "gonvex-cf-dev-actions", "entrypoint": "ActionWorker" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IngressObject"] }],
  "vars": {
    // Projects served, comma separated; the first is the default for `?project=`.
    "GONVEX_INGRESS_PROJECTS": "",
    // Per tenant: `<per second>/<burst>` (the gateway's 50/100), and for share pages.
    "GONVEX_INGRESS_TENANT_RATE": "50/100",
    "GONVEX_INGRESS_SHARE_RATE": "20/40",
    "GONVEX_SHARE_SITE_NAME": "Whagons",
    "GONVEX_SHARE_APP_SCHEME": "whagons",
    // The web app's origin for "Open on web"; `{tenant}` is the link's tenant selector.
    "GONVEX_SHARE_WEB_URL": "",
    // An imgproxy base turns the SVG card into the PNG most crawlers need. Empty: the SVG.
    "GONVEX_SHARE_IMAGE_PROXY_URL": ""
  }
}
