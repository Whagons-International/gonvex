{
  // S3 socket spike. Deployed only as gonvex-cf-dev-s3 on the development account, deleted after the run.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gonvex-cf-dev-s3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [
      { "name": "TENANT", "class_name": "TenantDO" },
      { "name": "GATEWAY", "class_name": "GatewayDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantDO", "GatewayDO"] }],
  "vars": { "BUILD": "a" }
}
