// Gonvex on Cloudflare: Worker + SQLite-backed Durable Objects.
// Deploys go through scripts/deploy-preview.mjs, which overrides `name` with
// gonvex-cf-dev-preview-<branch-slug>. The default name keeps the
// gonvex-cf-dev- prefix so an accidental `wrangler deploy` stays in the
// development namespace.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gonvex-cf-dev-local",
  "main": "legacy-worker.ts",
  // Must not be newer than the pinned workerd (wrangler 4.155.0 -> workerd 1.20261023.1).
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "HELLO", "class_name": "HelloObject" },
      // K05: gateway objects hold client sockets (0016 G0-1).
      { "name": "GATEWAY", "class_name": "GatewayObject" },
      // K05 stand-ins for the control object (K06) and the tenant object; replaced by those packages.
      { "name": "CONTROL_STUB", "class_name": "ControlStubObject" },
      { "name": "TENANT_STUB", "class_name": "TenantStubObject" },
      // K16: one object per client address bucket: pending and public sockets, calls per address (0040).
      { "name": "PUBLIC_LIMITER", "class_name": "PublicLimiterObject" }
    ]
  },
  "vars": {
    // A.1.3 runtimeVersion. Deploys set the Git SHA; "development" matches a local Rust runtime.
    "GONVEX_RUNTIME_VERSION": "development",
    // Gateway shards: expected concurrent sockets / 125 (S3). Stage 1 fixed count (0004).
    "GONVEX_GATEWAY_SHARDS": "8",
    // Presence v2 advertised in session.ready, as Rust does by default.
    "GONVEX_PRESENCE": "1"
  },
  // Durable Object classes must be SQLite-backed: always `new_sqlite_classes`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HelloObject"] },
    { "tag": "v2", "new_sqlite_classes": ["GatewayObject", "ControlStubObject", "TenantStubObject"] },
    { "tag": "v3", "new_sqlite_classes": ["PublicLimiterObject"] }
  ]
}
