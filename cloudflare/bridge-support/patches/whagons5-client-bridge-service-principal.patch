diff --git a/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes.go b/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes.go
new file mode 100644
index 0000000000..89a80fe1da
--- /dev/null
+++ b/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes.go
@@ -0,0 +1,126 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+	"unicode/utf16"
+)
+
+// The bridge's writes that no member session may make go through a Gonvex
+// service principal, never through the tenant database: the runtime keeps each
+// tenant in its own SQLite file (Rust) or Durable Object (Cloudflare), so there
+// is no database for the bridge to open.
+//
+// The runtime is configured with one principal for the bridge, for example:
+//
+//	{"id":"whagons-legacy-bridge","tokenSha256":"<hex>","projects":["<project>"],
+//	 "functions":["legacyBridge.createBoardMessage"]}
+//
+// A service socket is bound to one project and tenant at `auth`, may call only
+// the allowlisted functions, and runs them as the system identity
+// `_gonvex_service:whagons-legacy-bridge` on the `api` channel
+// (gonvex docs/service-principals.md). The function re-checks everything the
+// write depends on in its own transaction.
+const (
+	servicePrincipalTokenPrefix   = "gvx_svc_"
+	legacyBoardMessageServicePath = "legacyBridge.createBoardMessage"
+)
+
+// writeLegacyBoardMessage is the fallback for a released app posting to a
+// board whose Boards powerup is disabled (recoverCompatibilityWrite). The
+// message id and the runtime idempotency key derive from the write's intent
+// key, so a phone retry or a bridge restart after commit creates one post.
+func (s *Server) writeLegacyBoardMessage(ctx context.Context, values map[string]any) (any, error) {
+	if s.config.ServicePrincipalToken == "" {
+		return nil, errors.New("legacy board message service principal is not configured")
+	}
+	tenantID := strings.TrimSpace(fmt.Sprint(values["tenantId"]))
+	boardID := strings.TrimSpace(fmt.Sprint(values["boardId"]))
+	createdBy := strings.TrimSpace(fmt.Sprint(values["createdBy"]))
+	title := strings.TrimSpace(fmt.Sprint(values["title"]))
+	content := strings.TrimSpace(fmt.Sprint(values["content"]))
+	if title == "<nil>" {
+		title = ""
+	}
+	if content == "<nil>" {
+		content = ""
+	}
+	if tenantID == "" || tenantID == "<nil>" || boardID == "" || boardID == "<nil>" || createdBy == "" || createdBy == "<nil>" {
+		return nil, errors.New("legacy board message tenant, board, and author are required")
+	}
+	if title == "" && content == "" {
+		return nil, errors.New("Post content is required")
+	}
+	if len(utf16.Encode([]rune(title))) > 200 {
+		return nil, errors.New("Post title cannot exceed 200 characters")
+	}
+	if len(utf16.Encode([]rune(content))) > 20000 {
+		return nil, errors.New("Post content cannot exceed 20000 characters")
+	}
+	entity := map[string]any{"boardId": boardID, "createdBy": createdBy}
+	if title != "" {
+		entity["title"] = title
+	}
+	if content != "" {
+		entity["content"] = content
+	}
+	var startsAt, endsAt int64
+	if value, ok := unixMillis(values["startsAt"]); ok {
+		startsAt = int64(value)
+		entity["startsAt"] = startsAt
+	}
+	if value, ok := unixMillis(values["endsAt"]); ok {
+		endsAt = int64(value)
+		entity["endsAt"] = endsAt
+	}
+	if entity["startsAt"] != nil && entity["endsAt"] != nil && endsAt <= startsAt {
+		return nil, errors.New("Post end time must be after its start time")
+	}
+	if value, ok := values["isPinned"].(bool); ok {
+		entity["isPinned"] = value
+	}
+
+	intent := releaseRequestKey(ctx)
+	if intent == "" {
+		// Every phone write carries a request key; this only guards direct callers.
+		intent = fmt.Sprintf("unkeyed-%d-%d", time.Now().UTC().UnixNano(), s.compatSerial.Add(1))
+	}
+	entity["_id"] = "legacy-board-message-" + deterministicEntityID("legacy-board-message:"+intent)
+	result, err := s.callAsServicePrincipal(ctx, tenantID, legacyBoardMessageServicePath,
+		map[string]any{"entity": entity}, "legacy-board-message:"+intent)
+	if err != nil {
+		return nil, fmt.Errorf("legacy board message: %w", err)
+	}
+	return result, nil
+}
+
+// callAsServicePrincipal opens a short-lived service socket bound to the
+// tenant, calls one Reducer with an idempotency key, and closes the socket.
+// The calls it serves are rare, so it holds no connection open.
+func (s *Server) callAsServicePrincipal(ctx context.Context, tenant, path string, args map[string]any, idempotencyKey string) (any, error) {
+	runtimeTenant := s.runtimeTenant(tenant)
+	client := newUpstreamClient(s.config.GonvexWebSocketURL, s.config.ProjectID, runtimeTenant, s.config.OperationTimeout)
+	if err := client.connect(ctx); err != nil {
+		return nil, err
+	}
+	defer client.close()
+	authID := client.nextID("service-auth")
+	response, err := client.request(ctx, map[string]any{
+		"type":    "auth",
+		"id":      authID,
+		"token":   s.config.ServicePrincipalToken,
+		"project": s.config.ProjectID,
+		"tenant":  runtimeTenant,
+	}, authID)
+	if err != nil {
+		return nil, fmt.Errorf("authenticate service principal: %w", err)
+	}
+	if response.err != "" {
+		return nil, fmt.Errorf("authenticate service principal: %s", response.err)
+	}
+	result, err, _ := client.callOnce(ctx, "mutation", client.nextID("service-call"), path, args, idempotencyKey)
+	return result, err
+}
diff --git a/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes_test.go b/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes_test.go
new file mode 100644
index 0000000000..226a16f632
--- /dev/null
+++ b/compatibility/legacy-convex-v5.1.29-bridge/service_principal_writes_test.go
@@ -0,0 +1,296 @@
+package main
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/gorilla/websocket"
+)
+
+// serviceRuntime is a minimal runtime that speaks the service-principal
+// protocol (gonvex docs/service-principals.md): `auth` with a `gvx_svc_`
+// token binds the socket to a project and tenant; only allowlisted
+// Reducers may be called; a repeated idempotency key replays the result.
+type serviceRuntime struct {
+	t        *testing.T
+	server   *httptest.Server
+	token    string
+	allowed  string
+	mu       sync.Mutex
+	dials    []string // tenant query parameter per socket
+	frames   []map[string]any
+	receipts map[string]any
+	rejectAs string // reducer.error text for every call, when set
+}
+
+func newServiceRuntime(t *testing.T, token, allowed string) *serviceRuntime {
+	runtime := &serviceRuntime{t: t, token: token, allowed: allowed, receipts: map[string]any{}}
+	runtime.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		runtime.mu.Lock()
+		runtime.dials = append(runtime.dials, r.URL.Query().Get("tenant"))
+		runtime.mu.Unlock()
+		_ = conn.WriteJSON(map[string]any{"type": "session.ready", "capabilities": map[string]any{}})
+		authenticated := false
+		for {
+			var frame map[string]any
+			if err := conn.ReadJSON(&frame); err != nil {
+				return
+			}
+			runtime.mu.Lock()
+			runtime.frames = append(runtime.frames, frame)
+			runtime.mu.Unlock()
+			id, _ := frame["id"].(string)
+			switch frame["type"] {
+			case "auth":
+				if frame["token"] != runtime.token {
+					_ = conn.WriteJSON(map[string]any{"type": "auth.error", "id": id, "error": "invalid service principal credential"})
+					continue
+				}
+				authenticated = true
+				_ = conn.WriteJSON(map[string]any{"type": "auth.result", "id": id, "result": map[string]any{"principalId": "whagons-legacy-bridge"}})
+			case "reducer.call":
+				path, _ := frame["path"].(string)
+				runtime.mu.Lock()
+				allowed, rejectAs := runtime.allowed, runtime.rejectAs
+				runtime.mu.Unlock()
+				switch {
+				case !authenticated:
+					_ = conn.WriteJSON(map[string]any{"type": "reducer.error", "id": id, "error": "authenticate with an active tenant before calling a Reducer"})
+				case path != allowed:
+					_ = conn.WriteJSON(map[string]any{"type": "reducer.error", "id": id, "error": `function "` + path + `" is not allowed for this service principal`})
+				case rejectAs != "":
+					_ = conn.WriteJSON(map[string]any{"type": "reducer.error", "id": id, "error": rejectAs})
+				default:
+					key, _ := frame["idempotencyKey"].(string)
+					runtime.mu.Lock()
+					result, replay := runtime.receipts[key]
+					if !replay {
+						entity, _ := frame["args"].(map[string]any)["entity"].(map[string]any)
+						result = entity["_id"]
+						runtime.receipts[key] = result
+					}
+					runtime.mu.Unlock()
+					_ = conn.WriteJSON(map[string]any{"type": "reducer.result", "id": id, "result": result})
+				}
+			}
+		}
+	}))
+	t.Cleanup(runtime.server.Close)
+	return runtime
+}
+
+func (r *serviceRuntime) url() string { return "ws" + strings.TrimPrefix(r.server.URL, "http") + "/ws" }
+
+func (r *serviceRuntime) framesOfType(kind string) []map[string]any {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	var out []map[string]any
+	for _, frame := range r.frames {
+		if frame["type"] == kind {
+			out = append(out, frame)
+		}
+	}
+	return out
+}
+
+const testServiceToken = "gvx_svc_test-token-0123456789abcdef"
+
+func newServiceBridge(t *testing.T, runtime *serviceRuntime, token string) *Server {
+	t.Helper()
+	bridge, err := NewServer(Config{
+		GonvexWebSocketURL:    runtime.url(),
+		ProjectID:             "whagons-5",
+		ServicePrincipalToken: token,
+		TenantAliases:         map[string]string{"released-slug": "runtime-tenant"},
+	})
+	if err != nil {
+		t.Fatalf("create bridge: %v", err)
+	}
+	return bridge
+}
+
+func TestLegacyBoardMessageUsesTheServicePrincipal(t *testing.T) {
+	runtime := newServiceRuntime(t, testServiceToken, legacyBoardMessageServicePath)
+	bridge := newServiceBridge(t, runtime, testServiceToken)
+	ctx := withReleaseRequestKey(context.Background(), "intent-board-post-1")
+	values := map[string]any{
+		"tenantId": "released-slug", "boardId": "board-a", "createdBy": "member-a",
+		"title": "  Weekly  ", "content": "Shift change at 6", "isPinned": true,
+		"startsAt": float64(1000), "endsAt": float64(2000),
+	}
+	first, err := bridge.writeLegacyBoardMessage(ctx, values)
+	if err != nil {
+		t.Fatalf("service write: %v", err)
+	}
+	// A phone retry (or a bridge restart) reuses the intent key: same id, same key.
+	second, err := bridge.writeLegacyBoardMessage(ctx, values)
+	if err != nil {
+		t.Fatalf("service write replay: %v", err)
+	}
+	if first != second || !strings.HasPrefix(first.(string), "legacy-board-message-") {
+		t.Fatalf("message ids = %v, %v", first, second)
+	}
+
+	runtime.mu.Lock()
+	dials := append([]string(nil), runtime.dials...)
+	runtime.mu.Unlock()
+	if len(dials) != 2 || dials[0] != "runtime-tenant" {
+		t.Fatalf("service sockets dialed tenants %v, want the runtime tenant alias", dials)
+	}
+	auths := runtime.framesOfType("auth")
+	if len(auths) != 2 {
+		t.Fatalf("auth frames = %d", len(auths))
+	}
+	auth := auths[0]
+	if auth["token"] != testServiceToken || auth["project"] != "whagons-5" || auth["tenant"] != "runtime-tenant" || auth["controlOnly"] != nil {
+		t.Fatalf("service auth frame = %#v", auth)
+	}
+	calls := runtime.framesOfType("reducer.call")
+	if len(calls) != 2 {
+		t.Fatalf("reducer calls = %d", len(calls))
+	}
+	call := calls[0]
+	if call["path"] != legacyBoardMessageServicePath || call["scope"] != nil {
+		t.Fatalf("service call = %#v", call)
+	}
+	if call["idempotencyKey"] != "legacy-board-message:intent-board-post-1" || calls[1]["idempotencyKey"] != call["idempotencyKey"] {
+		t.Fatalf("idempotency keys = %v, %v", call["idempotencyKey"], calls[1]["idempotencyKey"])
+	}
+	entity := call["args"].(map[string]any)["entity"].(map[string]any)
+	want := map[string]any{
+		"_id": first, "boardId": "board-a", "createdBy": "member-a", "title": "Weekly",
+		"content": "Shift change at 6", "isPinned": true, "startsAt": float64(1000), "endsAt": float64(2000),
+	}
+	if len(entity) != len(want) {
+		t.Fatalf("entity = %#v, want %#v", entity, want)
+	}
+	for key, value := range want {
+		if entity[key] != value {
+			t.Fatalf("entity[%s] = %#v, want %#v (entity %#v)", key, entity[key], value, entity)
+		}
+	}
+	if _, ok := call["args"].(map[string]any)["tenantId"]; ok {
+		t.Fatal("tenant routing argument leaked into the service call")
+	}
+}
+
+func TestLegacyBoardMessageFailsClosedWithoutAServicePrincipal(t *testing.T) {
+	runtime := newServiceRuntime(t, testServiceToken, legacyBoardMessageServicePath)
+	bridge := newServiceBridge(t, runtime, "")
+	_, err := bridge.writeLegacyBoardMessage(context.Background(), map[string]any{
+		"tenantId": "t", "boardId": "b", "createdBy": "m", "content": "x",
+	})
+	if err == nil || !strings.Contains(err.Error(), "service principal is not configured") {
+		t.Fatalf("unconfigured write error = %v", err)
+	}
+	if len(runtime.dials) != 0 {
+		t.Fatal("an unconfigured bridge dialed the runtime")
+	}
+	if _, err := NewServer(Config{GonvexWebSocketURL: runtime.url(), ProjectID: "p", ServicePrincipalToken: "gvx_imp_wrong"}); err == nil {
+		t.Fatal("a non-service credential was accepted")
+	}
+}
+
+func TestLegacyBoardMessageValidatesBeforeDialing(t *testing.T) {
+	runtime := newServiceRuntime(t, testServiceToken, legacyBoardMessageServicePath)
+	bridge := newServiceBridge(t, runtime, testServiceToken)
+	cases := map[string]map[string]any{
+		"Post content is required":                   {"tenantId": "t", "boardId": "b", "createdBy": "m"},
+		"Post title cannot exceed 200 characters":    {"tenantId": "t", "boardId": "b", "createdBy": "m", "title": strings.Repeat("a", 201)},
+		"Post end time must be after its start time": {"tenantId": "t", "boardId": "b", "createdBy": "m", "content": "x", "startsAt": float64(5), "endsAt": float64(5)},
+		"tenant, board, and author are required":     {"boardId": "b", "createdBy": "m", "content": "x"},
+	}
+	for want, values := range cases {
+		if _, err := bridge.writeLegacyBoardMessage(context.Background(), values); err == nil || !strings.Contains(err.Error(), want) {
+			t.Fatalf("%s: error = %v", want, err)
+		}
+	}
+	if len(runtime.dials) != 0 {
+		t.Fatal("an invalid post dialed the runtime")
+	}
+}
+
+func TestLegacyBoardMessageSurfacesRuntimeRefusals(t *testing.T) {
+	runtime := newServiceRuntime(t, testServiceToken, "someOther.function")
+	bridge := newServiceBridge(t, runtime, testServiceToken)
+	values := map[string]any{"tenantId": "t", "boardId": "b", "createdBy": "m", "content": "x"}
+	if _, err := bridge.writeLegacyBoardMessage(context.Background(), values); err == nil || !strings.Contains(err.Error(), "is not allowed for this service principal") {
+		t.Fatalf("allowlist refusal = %v", err)
+	}
+	wrongToken := newServiceBridge(t, runtime, "gvx_svc_not-the-configured-one")
+	if _, err := wrongToken.writeLegacyBoardMessage(context.Background(), values); err == nil || !strings.Contains(err.Error(), "authenticate service principal") {
+		t.Fatalf("credential refusal = %v", err)
+	}
+	runtime.mu.Lock()
+	runtime.allowed = legacyBoardMessageServicePath
+	runtime.rejectAs = "TypeScript module host returned 500: Not authorized to publish to this board"
+	runtime.mu.Unlock()
+	if _, err := bridge.writeLegacyBoardMessage(context.Background(), values); err == nil || !strings.Contains(err.Error(), "Not authorized to publish to this board") {
+		t.Fatalf("reducer refusal = %v", err)
+	}
+}
+
+// TestServicePrincipalE2E runs the real writer against a live runtime that has
+// the bridge's service principal configured. It skips unless every variable is
+// set; gonvex `cloudflare/bridge-support/verify/service-principal.mjs` starts a
+// runtime and runs it. The runtime must allowlist
+// legacyBridge.createBoardMessage and not legacyBridge.notAllowed.
+func TestServicePrincipalE2E(t *testing.T) {
+	names := []string{"BRIDGE_SERVICE_E2E_WS_URL", "BRIDGE_SERVICE_E2E_PROJECT", "BRIDGE_SERVICE_E2E_TENANT", "BRIDGE_SERVICE_E2E_TOKEN"}
+	values := map[string]string{}
+	for _, name := range names {
+		values[name] = os.Getenv(name)
+	}
+	set := 0
+	for _, value := range values {
+		if value != "" {
+			set++
+		}
+	}
+	if set == 0 {
+		t.Skip("set BRIDGE_SERVICE_E2E_* to run against a live runtime")
+	}
+	if set != len(names) {
+		t.Fatalf("partial live configuration: need all of %v", names)
+	}
+	bridge, err := NewServer(Config{
+		GonvexWebSocketURL:    values["BRIDGE_SERVICE_E2E_WS_URL"],
+		ProjectID:             values["BRIDGE_SERVICE_E2E_PROJECT"],
+		ServicePrincipalToken: values["BRIDGE_SERVICE_E2E_TOKEN"],
+	})
+	if err != nil {
+		t.Fatalf("create bridge: %v", err)
+	}
+	tenant := values["BRIDGE_SERVICE_E2E_TENANT"]
+	ctx := withReleaseRequestKey(context.Background(), "e2e-intent-1")
+	post := map[string]any{"tenantId": tenant, "boardId": "board-e2e", "createdBy": "member-e2e", "title": "E2E", "content": "through the service principal", "isPinned": true}
+	first, err := bridge.writeLegacyBoardMessage(ctx, post)
+	if err != nil {
+		t.Fatalf("service write: %v", err)
+	}
+	replay, err := bridge.writeLegacyBoardMessage(ctx, post)
+	if err != nil || replay != first {
+		t.Fatalf("replay = %v, %v; want %v", replay, err, first)
+	}
+	if _, err := bridge.callAsServicePrincipal(context.Background(), tenant, "legacyBridge.notAllowed", map[string]any{}, "e2e-not-allowed"); err == nil || !strings.Contains(err.Error(), "is not allowed for this service principal") {
+		t.Fatalf("allowlist refusal = %v", err)
+	}
+	wrong, err := NewServer(Config{GonvexWebSocketURL: values["BRIDGE_SERVICE_E2E_WS_URL"], ProjectID: values["BRIDGE_SERVICE_E2E_PROJECT"], ServicePrincipalToken: "gvx_svc_wrong"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := wrong.writeLegacyBoardMessage(ctx, post); err == nil || !strings.Contains(err.Error(), "authenticate service principal") {
+		t.Fatalf("wrong credential = %v", err)
+	}
+	t.Logf("E2E message id %v", first)
+}
diff --git a/gonvex/legacyBridge.ts b/gonvex/legacyBridge.ts
new file mode 100644
index 0000000000..920841aed9
--- /dev/null
+++ b/gonvex/legacyBridge.ts
@@ -0,0 +1,129 @@
+import { selectRows as readDataRows, dataValue as readDataValue } from "@gonvex/module-sdk";
+import { internalReducer, schema } from "@gonvex/module-sdk";
+import type { JsonObject, ReducerContext } from "@gonvex/module-sdk";
+import { isTenantAdministrator } from "../shared/memberAuthorization";
+import { text } from "../shared/values.js";
+import { boardColumns, boardMemberColumns, utf16Length } from "./boards/common";
+
+/**
+ * Writes for the legacy mobile compatibility bridge
+ * (`compatibility/legacy-convex-v5.1.29-bridge/`) that no member session may
+ * make. They replace the bridge's direct database writes: the runtime keeps
+ * each tenant in its own SQLite file or Durable Object, so there is no
+ * database for the bridge to open.
+ *
+ * Only the bridge's service principal reaches them: they are internal (no
+ * client may call them), the runtime allowlists them for that principal, and
+ * each checks the caller below. A service principal runs as the system
+ * identity `_gonvex_service:<id>` on the `api` channel.
+ */
+export const LEGACY_BRIDGE_SERVICE_PRINCIPAL = "whagons-legacy-bridge";
+
+type Row = JsonObject;
+
+const requireLegacyBridge = (ctx: ReducerContext): void => {
+  if (ctx.invocation?.channel !== "api" || ctx.member?.id !== `_gonvex_service:${LEGACY_BRIDGE_SERVICE_PRINCIPAL}`) {
+    throw new Error("Only the legacy mobile bridge may call this function");
+  }
+};
+
+/** The author's tenant Member, active, with the role the publish check needs. */
+const activeAuthor = async (ctx: ReducerContext, memberId: string): Promise<Row> => {
+  const [member] = await readDataRows<Row>(ctx.db, {
+    key: "id",
+    table: "members",
+    columns: ["id", "status", "role"],
+    where: { column: "id", op: "eq", value: readDataValue(memberId) },
+    limit: 1,
+  });
+  if (!member || text(member.status) !== "active") throw new Error("Not authenticated");
+  return member;
+};
+
+/** `boardManageableByMember` for a Member other than the caller. */
+const authorCanPublish = async (ctx: ReducerContext, board: Row, author: Row): Promise<boolean> => {
+  const memberId = text(author.id);
+  if (isTenantAdministrator(author as { role?: string }) || text(board.createdBy) === memberId) return true;
+  const admins = (await readDataRows<Row>(ctx.db, {
+    table: "boardMembers",
+    columns: boardMemberColumns,
+    where: { column: "boardId", op: "eq", value: readDataValue(text(board._id)) },
+    limit: 100000,
+  })).filter((member) => String(member.role ?? "member") === "admin");
+  if (admins.some((member) => member.memberType === "user" && text(member.memberId) === memberId)) return true;
+  const adminTeams = new Set(admins.filter((member) => member.memberType === "team").map((member) => text(member.memberId)));
+  if (adminTeams.size === 0) return false;
+  const teams = await readDataRows<Row>(ctx.db, {
+    table: "memberTeams",
+    columns: ["teamId"],
+    where: { and: [{ column: "memberId", op: "eq", value: readDataValue(memberId) }, { column: "deletedAt", op: "isNull" }] },
+    limit: 100000,
+  });
+  return teams.some((team) => adminTeams.has(text(team.teamId)));
+};
+
+/**
+ * A released app's post to a board whose Boards powerup is disabled. The
+ * bridge has already resolved the board and the author from the member's own
+ * session; this re-checks both in the write's transaction. The bridge derives
+ * `_id` and the idempotency key from the phone's write intent, so a retry
+ * returns the first result. Like the direct insert it replaces, it writes no
+ * notifications: the powerup that delivers them is off.
+ */
+export const createBoardMessage = internalReducer({
+  args: schema.object({
+    entity: schema.object({
+      _id: schema.string(),
+      boardId: schema.string(),
+      createdBy: schema.string(),
+      title: schema.optional(schema.string()),
+      content: schema.optional(schema.string()),
+      isPinned: schema.optional(schema.boolean()),
+      startsAt: schema.optional(schema.number()),
+      endsAt: schema.optional(schema.number()),
+    }),
+  }),
+  result: schema.string(),
+  offline: { mode: "onlineOnly", reason: "Called only by the legacy mobile bridge's service principal." },
+  run: async (ctx: ReducerContext, args: {
+    entity: {
+      _id: string;
+      boardId: string;
+      createdBy: string;
+      title?: string;
+      content?: string;
+      isPinned?: boolean;
+      startsAt?: number;
+      endsAt?: number;
+    };
+  }): Promise<string> => {
+    requireLegacyBridge(ctx);
+    const entity = args.entity;
+    const id = entity._id.trim();
+    if (!id.startsWith("legacy-board-message-")) throw new Error("Invalid legacy board message id");
+    const author = await activeAuthor(ctx, entity.createdBy);
+    const [board] = await readDataRows<Row>(ctx.db, {
+      table: "boards",
+      columns: boardColumns,
+      where: { column: "_id", op: "eq", value: readDataValue(entity.boardId) },
+      limit: 1,
+    });
+    if (!board || board.deletedAt != null) throw new Error("Not found");
+    if (!await authorCanPublish(ctx, board, author)) throw new Error("Not authorized to publish to this board");
+    const title = entity.title?.trim() ?? "";
+    const content = entity.content?.trim() ?? "";
+    if (!title && !content) throw new Error("Post content is required");
+    if (utf16Length(title) > 200) throw new Error("Post title cannot exceed 200 characters");
+    if (utf16Length(content) > 20000) throw new Error("Post content cannot exceed 20000 characters");
+    if (entity.startsAt !== undefined && entity.endsAt !== undefined && entity.endsAt <= entity.startsAt) {
+      throw new Error("Post end time must be after its start time");
+    }
+    const values: Row = { _id: id, _creationTime: ctx.now, boardId: text(board._id), createdBy: text(author.id), isPinned: entity.isPinned === true };
+    if (title) values.title = title;
+    if (content) values.content = content;
+    if (entity.startsAt !== undefined) values.startsAt = entity.startsAt;
+    if (entity.endsAt !== undefined) values.endsAt = entity.endsAt;
+    await ctx.db.insert<Row>("boardMessages", values);
+    return id;
+  },
+});
