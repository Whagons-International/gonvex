+import { describe, expect, it, vi } from "vitest";
+
+import { createBoardMessage, LEGACY_BRIDGE_SERVICE_PRINCIPAL } from "../legacyBridge";
+
+type Tables = {
+  members?: Record<string, unknown>[];
+  boards?: Record<string, unknown>[];
+  boardMembers?: Record<string, unknown>[];
+  memberTeams?: Record<string, unknown>[];
+};
+
+const service = { id: `_gonvex_service:${LEGACY_BRIDGE_SERVICE_PRINCIPAL}`, status: "system", role: "system", permissions: {} };
+
+const harness = (tables: Tables, overrides: Record<string, unknown> = {}) => {
+  const query = vi.fn(async (sql: string) => {
+    for (const table of ["boardMembers", "memberTeams", "members", "boards"] as const) {
+      if (sql.includes(`FROM "${table}"`)) return tables[table] ?? [];
+    }
+    return [];
+  });
+  const insert = vi.fn(async (_table: string, row: Record<string, unknown>) => row);
+  const ctx = {
+    tenant: { id: "tenant-1" },
+    member: service,
+    invocation: { channel: "api", rootChannel: "api" },
+    now: 5_000,
+    db: { query, insert },
+    ...overrides,
+  };
+  return { ctx, query, insert };
+};
+
+const run = (ctx: unknown, entity: Record<string, unknown>) => (createBoardMessage as any).handler(ctx, { entity });
+
+const post = { _id: "legacy-board-message-1", boardId: "board-1", createdBy: "member-1", content: " Shift change at 6 " };
+const board = { _id: "board-1", createdBy: "member-9", visibility: "private", deletedAt: null };
+
+describe("legacy bridge board posts", () => {
+  it("inserts the post for an author who may publish, stamped by the runtime clock", async () => {
+    const { ctx, insert } = harness({ members: [{ id: "member-1", status: "active", role: "admin" }], boards: [board] });
+    await expect(run(ctx, { ...post, title: "Weekly", isPinned: true, startsAt: 6_000, endsAt: 7_000 })).resolves.toBe("legacy-board-message-1");
+    expect(insert).toHaveBeenCalledTimes(1);
+    expect(insert).toHaveBeenCalledWith("boardMessages", {
+      _id: "legacy-board-message-1", _creationTime: 5_000, boardId: "board-1", createdBy: "member-1",
+      title: "Weekly", content: "Shift change at 6", isPinned: true, startsAt: 6_000, endsAt: 7_000,
+    });
+  });
+
+  it("accepts a board admin through a team", async () => {
+    const { ctx, insert } = harness({
+      members: [{ id: "member-1", status: "active", role: "member" }],
+      boards: [board],
+      boardMembers: [{ boardId: "board-1", memberType: "team", memberId: "team-1", role: "admin" }],
+      memberTeams: [{ teamId: "team-1" }],
+    });
+    await expect(run(ctx, post)).resolves.toBe("legacy-board-message-1");
+    expect(insert).toHaveBeenCalledOnce();
+  });
+
+  it("refuses an author who cannot publish to the board", async () => {
+    const { ctx, insert } = harness({
+      members: [{ id: "member-1", status: "active", role: "member" }],
+      boards: [board],
+      boardMembers: [{ boardId: "board-1", memberType: "user", memberId: "member-1", role: "member" }],
+    });
+    await expect(run(ctx, post)).rejects.toThrow("Not authorized to publish to this board");
+    expect(insert).not.toHaveBeenCalled();
+  });
+
+  it("refuses every caller but the bridge's service principal", async () => {
+    const tables = { members: [{ id: "member-1", status: "active", role: "admin" }], boards: [board] };
+    const member = harness(tables, { member: { id: "member-1", status: "active", role: "admin", permissions: {} }, invocation: { channel: "ui", rootChannel: "ui" } });
+    await expect(run(member.ctx, post)).rejects.toThrow("Only the legacy mobile bridge may call this function");
+    const otherService = harness(tables, { member: { ...service, id: "_gonvex_service:whagons-api-gateway" } });
+    await expect(run(otherService.ctx, post)).rejects.toThrow("Only the legacy mobile bridge may call this function");
+    const nested = harness(tables, { invocation: { channel: "agent", rootChannel: "api" } });
+    await expect(run(nested.ctx, post)).rejects.toThrow("Only the legacy mobile bridge may call this function");
+    expect(member.insert).not.toHaveBeenCalled();
+    expect(otherService.insert).not.toHaveBeenCalled();
+    expect(nested.insert).not.toHaveBeenCalled();
+  });
+
+  it("refuses an inactive author, a deleted board and a foreign id", async () => {
+    const inactive = harness({ members: [{ id: "member-1", status: "inactive", role: "admin" }], boards: [board] });
+    await expect(run(inactive.ctx, post)).rejects.toThrow("Not authenticated");
+    const deleted = harness({ members: [{ id: "member-1", status: "active", role: "admin" }], boards: [{ ...board, deletedAt: 1 }] });
+    await expect(run(deleted.ctx, post)).rejects.toThrow("Not found");
+    const foreign = harness({ members: [{ id: "member-1", status: "active", role: "admin" }], boards: [board] });
+    await expect(run(foreign.ctx, { ...post, _id: "message-1" })).rejects.toThrow("Invalid legacy board message id");
+    for (const h of [inactive, deleted, foreign]) expect(h.insert).not.toHaveBeenCalled();
+  });
+
+  it("keeps the released post limits", async () => {
+    const tables = { members: [{ id: "member-1", status: "active", role: "admin" }], boards: [board] };
+    await expect(run(harness(tables).ctx, { ...post, content: "  " })).rejects.toThrow("Post content is required");
+    await expect(run(harness(tables).ctx, { ...post, title: "a".repeat(201) })).rejects.toThrow("Post title cannot exceed 200 characters");
+    await expect(run(harness(tables).ctx, { ...post, startsAt: 5, endsAt: 5 })).rejects.toThrow("Post end time must be after its start time");
+  });
+});
