// K06 control object: test and development Worker (local workerd, vitest,
// conformance). The real router and tenant object come from K05/K01; this
// config wires the control object to a stub tenant object and a minimal
// control socket owner. Deploy only under a gonvex-cf-dev- name.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gonvex-cf-dev-control",
  "main": "test-support/worker.ts",
  // Must not be newer than the pinned workerd (wrangler 4.155.0 -> workerd 1.20261023.1).
  "compatibility_date": "2026-10-23",
  // node:crypto PBKDF2 at 210,000 rounds (decision 0007) and AES-GCM.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // The control schema is imported from rust/crates/store/src/control_schema.sql, unchanged.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlObject" },
      { "name": "TENANT", "class_name": "StubTenantObject" },
      { "name": "CONTROL_SOCKETS", "class_name": "ControlSocketObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlObject", "StubTenantObject", "ControlSocketObject"] }],
  "vars": {
    "GONVEX_RUNTIME_VERSION": "development"
  }
}
